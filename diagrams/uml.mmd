classDiagram
    class Owner {
        +str name
        +int available_minutes
        +datetime start_time
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +update_preferences(preferences) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        <<dataclass>>
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
    }

    class Task {
        <<dataclass>>
        +str title
        +int duration_minutes
        +str priority
        +str description
        +str frequency
        +int weekday
        +date due_date
        +set~date~ completed_dates
        +bool completed
        +update_details(title, duration_minutes, priority) None
        +is_completed(on_date) bool
        +is_due(on_date) bool
        +mark_complete(on_date) None
    }

    class Scheduler {
        +Owner owner
        +list~tuple~ schedule
        +str explanation
        +generate_plan() list~tuple~
        +explain_plan() str
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler --> "1" Owner : uses time and preferences from
    Scheduler --> "0..*" Pet : identifies pet for each entry
    Scheduler --> "0..*" Task : selects and assigns times

    %% Duration and availability are measured in minutes.
    %% start_time includes the planning date and clock time (Python datetime).
    %% Priority is low, medium, or high.
    %% Preferences are preferred task titles used to break equal-priority ties.
    %% Each Task instance belongs to one Pet.
    %% Each schedule tuple is (pet, task, start_datetime, end_datetime).
    %% The schedule contains consecutive, non-overlapping tasks within the time budget.
    %% End time equals start time plus task duration; the next task starts there.
    %% get_all_tasks returns (pet, task) pairs across the owner's pets.
    %% Frequency is daily, weekly, or once; weekly uses weekday (Monday=0).
    %% Only one-time tasks have due_date; unfinished overdue tasks remain due.
    %% weekday and due_date are optional and depend on the frequency.
    %% completed is a property for today's status (permanent for one-time tasks).
    %% completed_dates tracks occurrences without hiding future recurring tasks.
    %% All data is in memory; fixed appointment times and persistence are not implemented.
